---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const now = new Date();
  const posts = await getCollection('blog', ({ data }) => !data.draft && new Date(data.publishedAt) <= now);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="container-narrow py-16">
    <header class="mb-8">
      <a href="/blog" class="text-sm text-graphite hover:text-copper mb-4 inline-block"><span aria-hidden="true">&larr;</span> Back to blog</a>
      <h1 class="text-4xl mb-2">{post.data.title}</h1>
      <time class="text-graphite">
        {new Date(post.data.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </header>

    <div class="prose-custom">
      <Content />
    </div>
  </article>
</BaseLayout>
